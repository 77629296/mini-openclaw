{
  "name": "mini-openclaw",
  "private": true,
  "version": "0.1.0",
  "description": "OpenClaw 核心能力的精简重写",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:server": "pnpm --filter @mini-openclaw/server dev",
